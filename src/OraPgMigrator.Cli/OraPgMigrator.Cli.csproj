<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OraPgMigrator.Core\OraPgMigrator.Core.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Oracle\OraPgMigrator.Oracle.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Postgres\OraPgMigrator.Postgres.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Infrastructure\OraPgMigrator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>orapg</AssemblyName>
    <RootNamespace>OraPgMigrator.Cli</RootNamespace>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Publish as a single self-contained file with no side-by-side dependencies.
    Only applies when publishing for a specific RuntimeIdentifier; plain
    `dotnet build`/`dotnet test` (no RID) are unaffected. DebugType is
    scoped here too, so normal dev/test builds keep their PDBs for
    source-level debugging.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Native AOT for win-x64: compiles straight to a native orapg.exe (no
    embedded IL/CLR to self-extract), which is smaller and starts faster
    than the single-file-with-CLR publish above. PublishSingleFile is
    ignored by the AOT toolchain, so no conflict with the group above.
    StripSymbols disables generation of the separate native debug symbol
    file (orapg.pdb on Windows) that the AOT toolchain emits independently
    of DebugType.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!--
      Oracle.ManagedDataAccess and CsvHelper are not trim/AOT-annotated
      libraries; their reflection-based paths (not used by this CLI's
      supported code paths) surface as IL2104/IL3053 trim-analysis warnings
      and IL3000 warnings from Assembly.Location usage in single-file apps.
      These are known, expected, and non-actionable from our side, so they
      are suppressed rather than silencing trim warnings project-wide.
    -->
    <NoWarn>$(NoWarn);IL2104;IL3053;IL3000</NoWarn>
  </PropertyGroup>

</Project>
