<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OraPgMigrator.Core\OraPgMigrator.Core.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Oracle\OraPgMigrator.Oracle.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Postgres\OraPgMigrator.Postgres.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Infrastructure\OraPgMigrator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>orapg</AssemblyName>
    <RootNamespace>OraPgMigrator.Cli</RootNamespace>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Publish as a single self-contained file with no side-by-side dependencies.
    Only applies when publishing for a specific RuntimeIdentifier; plain
    `dotnet build`/`dotnet test` (no RID) are unaffected. DebugType is
    scoped here too, so normal dev/test builds keep their PDBs for
    source-level debugging.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Belt-and-suspenders: referenced projects (Core, Infrastructure, Oracle,
    Postgres) don't inherit this project's DebugType, so their PDBs land in
    the publish output despite it. Delete every .pdb from the publish
    directory after publish completes so none ship.
  -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish">
    <ItemGroup>
      <PublishPdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbFiles)" Condition="'@(PublishPdbFiles)' != ''" />
  </Target>

</Project>
