<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OraPgMigrator.Core\OraPgMigrator.Core.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Oracle\OraPgMigrator.Oracle.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Postgres\OraPgMigrator.Postgres.csproj" />
    <ProjectReference Include="..\OraPgMigrator.Infrastructure\OraPgMigrator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>orapg</AssemblyName>
    <RootNamespace>OraPgMigrator.Cli</RootNamespace>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Publish as a single self-contained file with no side-by-side dependencies.
    Only applies when publishing for a specific RuntimeIdentifier; plain
    `dotnet build`/`dotnet test` (no RID) are unaffected.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    Native AOT for win-x64: compiles straight to a native orapg.exe (no
    embedded IL/CLR to self-extract), which is smaller and starts faster
    than the single-file-with-CLR publish above. PublishSingleFile is
    ignored by the AOT toolchain, so no conflict with the group above.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

</Project>
